# Python
__pycache__/
*.pyc

# The virtual environment — uv rebuilds it from pyproject.toml + uv.lock
.venv/

# Personal settings — copy config.example.toml to config.toml instead.
# This way your tweaks never fight with git updates.
config.toml

# Per-machine window positions (saved when you drag her somewhere).
# Delete this file to reset to the config's x/y defaults.
positions.json

# VTS Plugin token which let's PotaTuber talk to your specific VTube Studio.
vts_token.json

# The cached, Live2D related JS libraries.
frontend/vendor/

# Ignore all Live2D models that aren't Pota-chan.
frontend/models/*
!frontend/models/Pota-chan/

# Voice samples are personal (and the caches next to them are generated).
# Only Pota-chan's own sample ships.
voices/*
!voices/default.wav

# pywebview local storage files
.pywebview_storage/